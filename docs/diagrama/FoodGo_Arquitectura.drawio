        <mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n101" value="FoodGo — Arquitectura de Microservicios (EP1 · JVY0101)  |  🔒 = zona con política de seguridad  |  línea continua = síncrono  |  línea punteada naranja = asíncrono/evento  |  línea roja gruesa = flujo de datos crítico" style="text;html=1;fontSize=11;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="22" as="geometry" /></mxCell><mxCell id="n102" value="Cliente&#10;(App móvil)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="160" height="50" as="geometry" /></mxCell><mxCell id="n103" value="Restaurante&#10;(Web)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="260" y="50" width="160" height="50" as="geometry" /></mxCell><mxCell id="n104" value="Repartidor&#10;(App móvil)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="50" width="160" height="50" as="geometry" /></mxCell><mxCell id="n105" value="Amazon API Gateway&#10;🔒 Autenticación JWT por rol (Cognito)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220" y="140" width="260" height="60" as="geometry" /></mxCell><mxCell id="n106" value="AWS Cloud Map&#10;(Service Registry)&#10;los servicios se descubren por nombre" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="140" width="200" height="60" as="geometry" /></mxCell><mxCell id="n110" value="ms-usuarios&#10;Identidad, auth, perfiles&#10;(SRP: gestión de identidad)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeW