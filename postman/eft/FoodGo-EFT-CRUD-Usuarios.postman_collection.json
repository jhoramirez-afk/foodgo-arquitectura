{
  "info": {
    "name": "FoodGo | EFT | CRUD Usuarios y direcciones",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Demostración EFT: CRUD real, relación JPA, errores y comprobación después del reinicio. No borra datos previos. Los DELETE usan exclusivamente los IDs capturados al crear. Ver guion para detenerse en SQL antes de eliminar. Validación HTTP de esta nueva colección pendiente."
  },
  "auth": {
    "type": "noauth"
  },
  "protocolProfileBehavior": {
    "followRedirects": false
  },
  "variable": [
    {
      "key": "usuarios_base_url",
      "value": "http://127.0.0.1:18081"
    },
    {
      "key": "correo_cliente",
      "value": "valentina.rojas@example.com"
    },
    {
      "key": "usuario_id",
      "value": ""
    },
    {
      "key": "direccion_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Crear, consultar y actualizar",
      "item": [
        {
          "name": "01 Crear cliente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json; charset=UTF-8"
              }
            ],
            "url": "{{usuarios_base_url}}/api/usuarios",
            "description": "Crea únicamente el cliente del ejercicio. Si el correo ya existe, no reutilizar IDs ajenos: resolver el ensayo anterior o escoger otro correo propio de demostración.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Valentina Rojas\",\n  \"rol\": \"CLIENTE\",\n  \"email\": \"{{correo_cliente}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset(\"usuario_id\");",
                  "pm.collectionVariables.unset(\"direccion_id\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) { const x=pm.response.json(); pm.collectionVariables.set(\"usuario_id\",String(x.id)); pm.test(\"Cliente creado con ID\",()=>pm.expect(x.id).to.be.a(\"number\")); } else { pm.execution.setNextRequest(null); }"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Listar clientes",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{usuarios_base_url}}/api/usuarios",
            "description": ""
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!/^\\d+$/.test(String(pm.collectionVariables.get(\"usuario_id\") || \"\"))) { pm.execution.skipRequest(); throw new Error(\"Primero crea el usuario con 01 y verifica HTTP 201; no escribas un ID ajeno.\"); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"La lista incluye al cliente creado\",()=>pm.expect(pm.response.json().some(x=>String(x.id)===pm.collectionVariables.get(\"usuario_id\"))).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Consultar cliente por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{usuarios_base_url}}/api/usuarios/{{usuario_id}}",
            "description": ""
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!/^\\d+$/.test(String(pm.collectionVariables.get(\"usuario_id\") || \"\"))) { pm.execution.skipRequest(); throw new Error(\"Primero crea el usuario con 01 y verifica HTTP 201; no escribas un ID ajeno.\"); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"ID solicitado\",()=>pm.expect(String(pm.response.json().id)).to.eql(pm.collectionVariables.get(\"usuario_id\")));"
                ]
              }
            }
          ]
        },
