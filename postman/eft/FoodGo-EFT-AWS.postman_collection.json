                "key": "Content-Type",
                "value": "application/json; charset=UTF-8"
              }
            ],
            "url": "{{api_base_url}}/notificaciones/api/notificaciones",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"canal\": \"EMAIL\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ]
