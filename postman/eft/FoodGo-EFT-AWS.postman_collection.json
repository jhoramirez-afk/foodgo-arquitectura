    {
      "name": "03 Notificaciones: productor, cola y consumidor",
      "description": "Ejecutar 03 y 04 una vez. Enviar 05 después de que Lambda procese el evento. No es un Runner automático con espera. El 202 no prueba que el consumidor haya terminado.",
      "item": [
        {
          "name": "03 Crear aviso del pedido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json; charset=UTF-8"
              }
            ],
            "url": "{{api_base_url}}/notificaciones/api/notificaciones",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"destinatario\": \"valentina.rojas@example.com\",\n  \"canal\": \"EMAIL\",\n  \"mensaje\": \"Valentina, tu pedido de La Cocina de Barrio está en camino.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset(\"notificacion_id\");",
                  "pm.collectionVariables.unset(\"evento_id\");",
                  "pm.collectionVariables.unset(\"consultas_evento\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) { pm.collectionVariables.set(\"notificacion_id\", pm.response.json().id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Publicar evento en SQS",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{api_base_url}}/notificaciones/api/notificaciones/{{notificacion_id}}/encolar"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset(\"evento_id\");",
                  "pm.collectionVariables.set(\"consultas_evento\",0);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 202\", () => pm.response.to.have.status(202));",
                  "if (pm.response.code === 202) { const r=pm.response.json();",
                  "  pm.test(\"SQS aceptó el evento\", () => { pm.expect(r.estado).to.eql(\"ENCOLADO\"); pm.expect(r.mensajeId).to.be.a(\"string\").and.not.empty; });",
                  "  pm.collectionVariables.set(\"evento_id\", r.eventoId); }"
                ]
              }
            }
          ]
        },
        {
          "name": "05 Esperar resultado persistido del evento",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{api_base_url}}/notificaciones/api/notificaciones/{{notificacion_id}}/intentos"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get(\"evento_id\") || !pm.collectionVariables.get(\"notificacion_id\")) { pm.execution.skipRequest(); throw new Error(\"Ejecutar 03 y 04 correctamente antes de consultar el resultado.\"); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); } else {",
                  "  const data=pm.response.json();",
                  "  pm.test(\"Respuesta de intentos es una lista\",()=>pm.expect(data).to.be.an(\"array\"));",
                  "  if (!Array.isArray(data)) { pm.execution.setNextRequest(null); } else {",
                  "    const rows=data.filter(r=>r.eventoId===pm.collectionVariables.get(\"evento_id\"));",
                  "    const count=Number(pm.collectionVariables.get(\"consultas_evento\")||0)+1;",
                  "    pm.collectionVariables.set(\"consultas_evento\",count);",
                  "    if(rows.length===0 && count<30){",
                  "      console.log(\"Procesamiento pendiente; consulta \"+count+\"/30. No es una confirmación de éxito.\");",
                  "      pm.execution.setNextRequest(pm.info.requestId);",
                  "    } else {",
                  "      pm.test(\"Un intento del mismo evento antes del límite\",()=>pm.expect(rows).to.have.lengthOf(1));",
                  "      if(rows.length===1){pm.test(\"Evento procesado como simulación académica\",()=>{pm.expect(rows[0].resultado).to.eql(\"ENVIADO\");pm.expect(rows[0].detalle).to.include(\"Simulación académica\");});}",
                  "      if(rows.length!==1 || rows[0].resultado!==\"ENVIADO\"){pm.execution.setNextRequest(null);}",
                  "      pm.collectionVariables.unset(\"consultas_evento\");",
                  "    }",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "06 ID inexistente: error del dominio",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{api_base_url}}/notificaciones/api/notificaciones/9223372036854775807/encolar"
