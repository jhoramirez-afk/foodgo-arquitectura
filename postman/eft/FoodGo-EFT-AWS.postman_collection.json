      "name": "01 Sin firma IAM: acceso rechazado",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{api_base_url}}/usuarios/api/usuarios",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
