{
  "info": {
    "name": "FoodGo | EFT AWS | Acceso y SQS-Lambda",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Configurar api_base_url con el ApiEndpoint del stack. Usar AWS Signature en la colección, servicio execute-api, región del laboratorio y tres credenciales temporales locales o de Vault. El archivo no contiene claves. Mantener desactivado el seguimiento de redirecciones para no reenviar datos de autorización a otro destino. En Runner: una iteración y Delay 1000 ms. GET 05 reintenta hasta 30 consultas si el evento aún no existe, exige exactamente un ENVIADO y falla al agotar el límite. En Send manual el encadenamiento no se ejecuta: esperar y repetir GET. Validación HTTP de esta copia pendiente."
  },
  "auth": {
    "type": "awsv4",
    "awsv4": [
      {
        "key": "accessKey",
        "value": "{{aws_access_key_id}}",
        "type": "string"
      },
      {
        "key": "secretKey",
        "value": "{{aws_secret_access_key}}",
        "type": "string"
      },
      {
        "key": "sessionToken",
        "value": "{{aws_session_token}}",
        "type": "string"
      },
      {
        "key": "region",
        "value": "{{aws_region}}",
        "type": "string"
      },
      {
        "key": "service",
        "value": "execute-api",
        "type": "string"
      }
    ]
  },
  "protocolProfileBehavior": {
    "followRedirects": false
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const base = pm.variables.replaceIn(\"{{api_base_url}}\");",
          "const match = /^https:\\/\\/[a-z0-9]+\\.execute-api\\.(us-east-1|us-west-2)\\.amazonaws\\.com\\/?$/.exec(base);",
          "if (!match || match[1] !== pm.variables.get(\"aws_region\")) {",
          "  console.error(\"Configurar api_base_url con el API Gateway HTTPS de la región del laboratorio.\");",
          "  pm.execution.skipRequest();",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "api_base_url",
      "value": ""
    },
    {
      "key": "aws_region",
      "value": "us-east-1"
    },
    {
      "key": "notificacion_id",
      "value": ""
    },
    {
      "key": "evento_id",
      "value": ""
    }
  ],
  "item": [
